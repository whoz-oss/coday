{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "{projectRoot}",
  "tags": ["web-bundle", "platform:npm"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["node index.js"],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "dev-server": {
      "continuous": true,
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx watch apps/server/src/server.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "BUILD_ENV": "development",
          "AGENTOS_URL": "http://localhost:8124",
          "FACTORY_URL": "http://localhost:8141"
        }
      }
    },
    "dev-agentos": {
      "continuous": true,
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./gradlew :agentos-service:bootRun",
        "cwd": "{workspaceRoot}/agentos"
      }
    },
    "dev-factory": {
      "continuous": true,
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./gradlew :factory-service:bootRun",
        "cwd": "{workspaceRoot}/factory"
      }
    },
    "serve:dev": {
      "continuous": true,
      "executor": "nx:noop",
      "dependsOn": [
        { "target": "serve", "projects": ["client", "factory-cockpit"] },
        "dev-server",
        "dev-agentos",
        "dev-factory"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "command": "node --test launcher.test.js",
        "cwd": "{projectRoot}"
      }
    },
    "build-first-run-jars": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        { "target": "bootJar", "projects": ["agentos-service", "factory-service"] },
        {
          "target": "assemble",
          "projects": [
            "agentos-bash-plugin",
            "agentos-file-plugin",
            "agentos-mcp-plugin",
            "agentos-http-plugin",
            "agentos-tmux-plugin",
            "agentos-git-plugin",
            "factory-forge-plugin"
          ]
        }
      ]
    },
    "first-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build", "build-first-run-jars"],
      "options": {
        "command": "tsx scripts/first-run.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "dependsOn": [],
      "options": {
        "packageRoot": "{projectRoot}"
      }
    }
  }
}
