{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "strictTemplates": false
  },
  "compilerOptions": {
    "module": "esnext",
    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "libs/**/*.test.tsx",
    "libs/**/*.spec.tsx",
    "libs/**/*.test.js",
    "libs/**/*.spec.js",
    "libs/**/*.test.jsx",
    "libs/**/*.spec.jsx"
  ],
  "extends": "./tsconfig.json",
  "include": ["**/*.ts", "../shared/*.ts"]
}
