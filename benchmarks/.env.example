# Copy to .env (git-ignored); promptfoo loads it automatically.
PROMPTFOO_DISABLE_TELEMETRY=1

# AgentOS backend, called directly (not through the Angular dev proxy).
AGENTOS_URL=http://localhost:8124
# Namespace id or name holding the agents and model aliases under test.
AGENTOS_NAMESPACE=coday
# Base URL of the AgentOS UI, used for the case links in results.
AGENTOS_UI_URL=http://localhost:4200

# Key of the gateway behind the aliases, for model-only tests and the grader.
REQUESTY_API_KEY=
