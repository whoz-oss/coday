{
  "name": "factory-sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "factory/factory-sdk/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"],
      "options": {
        "command": "./gradlew build",
        "cwd": "factory/factory-sdk"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./gradlew test",
        "cwd": "factory/factory-sdk"
      }
    }
  },
  "tags": ["type:lib", "platform:jvm", "scope:lib"]
}
