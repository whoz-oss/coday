{
  "name": "factory-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "factory/factory-service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"],
      "dependsOn": [{ "target": "build", "projects": ["factory-sdk", "factory-verification-core"] }],
      "options": {
        "command": "./gradlew build",
        "cwd": "factory/factory-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "target": "test", "projects": ["factory-sdk", "factory-verification-core"] }],
      "options": {
        "command": "./gradlew test",
        "cwd": "factory/factory-service"
      }
    },
    "bootRun": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./gradlew bootRun",
        "cwd": "factory/factory-service"
      }
    },
    "bootJar": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"],
      "options": {
        "command": "./gradlew bootJar",
        "cwd": "factory/factory-service"
      }
    },
    "generate-openapi-spec": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/factory/factory-service/openapi/factory-openapi.yaml"],
      "options": {
        "command": "./gradlew generateOpenApiDocs --no-configuration-cache",
        "cwd": "factory/factory-service"
      }
    },
    "check-openapi-spec": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/main/kotlin/**/*.kt",
        "{workspaceRoot}/factory/factory-service/openapi/factory-openapi.yaml"
      ],
      "options": {
        "command": "./check-openapi-spec.sh",
        "cwd": "factory/factory-service"
      }
    }
  },
  "tags": ["type:app", "platform:jvm", "scope:service"]
}
