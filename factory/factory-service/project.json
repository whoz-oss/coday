{
  "name": "factory-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "factory/factory-service/src",
  "implicitDependencies": ["factory-cockpit"],
  "targets": {
    "bootRun": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./gradlew :factory-service:bootRun",
        "cwd": "factory"
      }
    },
    "bootJar": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/build/libs"],
      "options": {
        "command": "./gradlew :factory-service:bootJar",
        "cwd": "factory"
      },
      "dependsOn": ["factory-cockpit:build", "assemble"]
    },
    "generate-openapi-spec": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/factory/factory-service/openapi/factory-openapi.yaml"],
      "options": {
        "command": "./gradlew :factory-service:generateOpenApiDocs --no-configuration-cache",
        "cwd": "factory"
      }
    },
    "check-openapi-spec": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/main/kotlin/**/*.kt",
        "{workspaceRoot}/factory/factory-service/openapi/factory-openapi.yaml"
      ],
      "options": {
        "command": "./check-openapi-spec.sh",
        "cwd": "factory/factory-service"
      }
    }
  },
  "tags": ["type:app", "platform:jvm-factory", "scope:service"]
}
